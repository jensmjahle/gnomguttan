# Runtime environment variables used by docker-compose.yml and injected at container start.

# MongoDB connection string used by the app server.
# In local development this can be omitted and the server will start a temporary in-memory database.
# This is usually an external MongoDB URI with username/password, for example:
# mongodb://username:password@host:27017/gnomguttan?authSource=admin
# or mongodb+srv://username:password@cluster.example.mongodb.net/gnomguttan?retryWrites=true&w=majority
MONGODB_URI=mongodb://username:password@host:27017/gnomguttan?authSource=admin

# MongoDB database name. If omitted, the database name is read from the URI path or falls back to gnomguttan.
MONGODB_DB=

# Directory where album originals + thumbnails are stored on disk.
# In docker-compose this is backed by the named volume "album-media" mounted at /data/album-media,
# so files survive redeploys. Locally (without Docker) it defaults to ./data/album-media.
ALBUM_MEDIA_DIR=/data/album-media

# Optional override for local Vite dev proxying to the app API
APP_API_TARGET=http://localhost:3001

# Port used by the Node server
PORT=3001

# Your self-hosted VoceChat instance URL (no trailing slash)
VOCECHAT_HOST=https://chat.gnomguttan.no

# App display title
APP_TITLE=Gnomguttan

# VoceChat bot announcement channel/group ID for the info bot
VOCECHAT_BOT_TARGET_GROUP_ID=

# VoceChat bot API key used by the container-side proxy, event reminder jobs,
# and GnomChat background push bridge.
# Keep this on the server side only; it is not exposed to the browser.
VOCECHAT_BOT_API_KEY=

# Jellyfin server URL for Hubert Cinema metadata/API access
# Use the direct Jellyfin server address here, not the client URL.
JELLYFIN_HOST=https://tv.jensmartin.no

# Jellyfin client URL used when opening movie/series pages
JELLYFIN_CLIENT_URL=https://kino.gnomguttan.no

# Jellyfin API key used by the runtime proxy
JELLYFIN_TOKEN=

# Home Assistant base URL reachable from the server, without a trailing slash.
# Example: http://homeassistant.local:8123
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Home Assistant long-lived access token used only by the server-side proxy.
HOME_ASSISTANT_TOKEN=

# Optional entity id for the widget. Use a switch or light entity.
# Defaults to switch.lampa_til_jens. HOME_ASSISTANT_LIGHT_ENTITY_ID is still accepted as a legacy alias.
HOME_ASSISTANT_ENTITY_ID=switch.lampa_til_jens

# GitHub webhook secret used to verify incoming payloads at POST /app-api/webhooks/github.
# Generate a strong random string and set the same value in your GitHub webhook settings.
# If omitted, signature verification is skipped (only safe for local dev).
GITHUB_WEBHOOK_SECRET=

# GitHub Personal Access Token (fine-grained, scoped to only the gnomguttan repo)
# used by the Dev page. The Kanban board derives status from issue state and an
# "in-progress" label, so only repository permissions are needed — no Projects access.
# Required repository permissions (gnomguttan only):
#   Issues:        Read and write  (issues, comments, assignees, labels, status)
#   Pull requests: Read            (PR list)
#   Contents:      Read and write  (releases + committing pasted/uploaded images)
#   Actions:       Read            (workflow runs)
#   Metadata:      Read            (required, auto-selected)
# If omitted, the /dev page shows an error and all /app-api/dev endpoints return 503.
GITHUB_TOKEN=

# GitHub repo in "owner/repo" format. Defaults to jensmjahle/gnomguttan if omitted.
GITHUB_REPO=jensmjahle/gnomguttan

# ── Valheim Server page ─────────────────────────────────────────────────────
# The page asks the Valheim server directly over the Steam query protocol, so an
# address is all it needs. Nothing here touches Docker.

# Address of the server, host and game port. Required for the page to show
# anything. The query port is derived from this (game port + 1).
VALHEIM_SERVER_ADDRESS=192.168.0.190:2456

# Password players need to join, shown on the page. Only logged-in users see it.
VALHEIM_SERVER_PASSWORD=

# Crossplay join code, if the server runs with -crossplay. Valheim only prints
# this to the server console, so it cannot be read over the network - set it here
# by hand, and update it if it changes.
VALHEIM_JOIN_CODE=

# World name shown on the card. Valheim does not report it over the network - it
# returns the server name instead - so set it here if you want it displayed.
VALHEIM_WORLD=Guttakos

# Optional: address shown to players instead of the one above, e.g. if you have
# a hostname like valheim.gnomguttan.no pointing at the server.
VALHEIM_PUBLIC_ADDRESS=
